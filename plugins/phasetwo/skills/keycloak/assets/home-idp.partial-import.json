{
  "ifResourceExists": "SKIP",
  "authenticationFlows": [
    {
      "alias": "homeIdp",
      "description": "Browser flow that redirects users to their organization's linked corporate identity provider, based on their email domain, with a password fallback.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-spnego",
          "authenticatorFlow": false,
          "requirement": "DISABLED",
          "priority": 20,
          "userSetupAllowed": false
        },
        {
          "authenticator": "identity-provider-redirector",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 25,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "requirement": "ALTERNATIVE",
          "priority": 30,
          "flowAlias": "homeIdp forms",
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "homeIdp forms",
      "description": "Username, password, otp and other auth forms.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "ext-auth-home-idp-discovery",
          "authenticatorConfig": "home-idp-discovery",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-password-form",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 21,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "home-idp-discovery",
      "config": {
        "forwardToLinkedIdp": "true"
      }
    }
  ]
}
