# OS
.DS_Store

# Editor / IDE
.idea/
.vscode/

# Local Claude Code settings (personal, not shared)
.claude/settings.local.json

# bench/benchflow tool cache (cloned agent manifests, datasets)
.cache/

# Local skillsbench eval run output (not part of task definitions)
benchmarks/**/jobs-local*/

# Local skillsbench oracle/agent batch runs across all benchmark items (run from repo root)
/jobs-oracle*/

# Python bytecode cache (e.g. from running skillsaw's custom rules.py)
__pycache__/

# Local API keys for bench agent runs - never commit
.env
